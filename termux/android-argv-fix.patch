 func main() {
+	// Termux/Android: a PIE binary launched through /system/bin/linker64
+	// receives argv with the executable path duplicated as the first
+	// argument, which Cobra rejects as an "unknown command". Drop the
+	// duplicate when present (no-op on normal platforms).
+	if len(os.Args) > 1 {
+		if exe, err := os.Executable(); err == nil && os.Args[1] == exe {
+			os.Args = append(os.Args[:1], os.Args[2:]...)
+		}
+	}
+
