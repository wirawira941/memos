 func main() {
+	// Termux/Android: a PIE binary launched through /system/bin/linker64
+	// receives argv with the executable path duplicated as the first
+	// argument, which Cobra rejects as an "unknown command". Drop the
+	// duplicate when present (no-op on normal platforms).
+	// NOTE: do not compare against os.Executable() here — on Android it
+	// returns the linker path ("/apex/com.android.runtime/bin/linker64"),
+	// never the binary's own path. Resolve argv[0] through PATH instead.
+	if len(os.Args) > 1 {
+		if exe, err := exec.LookPath(os.Args[0]); err == nil && os.Args[1] == exe {
+			os.Args = append(os.Args[:1], os.Args[2:]...)
+		}
+	}
+
 	if err := rootCmd.Execute(); err != nil {
 		slog.Error("memos failed", slog.String("error", err.Error()))
 		os.Exit(1)
